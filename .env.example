EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
OPENROUTER_API_KEY=
MODEL_PROFILE=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe (test mode first). The webhook endpoint is the stripe-webhook Edge Function.
APP_URL=http://localhost:8081
# Meta ads (web funnel). The Pixel id is public; the Conversions API token is a server secret (Edge Functions).
EXPO_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# Origins allowed to call the Edge Functions from the browser (comma separated). Defaults to APP_URL.
ALLOWED_ORIGINS=
# Sign in with Google / Apple: shown only when set to 1, after the provider is enabled in the Supabase dashboard.
EXPO_PUBLIC_AUTH_GOOGLE=
EXPO_PUBLIC_AUTH_APPLE=
# Native Google sign-in (phones). Client IDs from the Google Cloud console; the URL scheme is the iOS client's reversed
# ID. The Google config plugin is only added to the build when GOOGLE_IOS_URL_SCHEME is set (see app.config.js).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
