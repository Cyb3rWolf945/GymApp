# Admin backoffice (Next.js). Server-only values must never be exposed with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: used only in server components and route handlers (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
# Where the "Resend sign-in link" email sends the user (the web app's URL, no trailing slash).
APP_URL=
# Stripe dashboard base for the "Open customer" link: https://dashboard.stripe.com or https://dashboard.stripe.com/test.
STRIPE_DASHBOARD_URL=
